{
  "type": "object",
  "properties": {
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "card": { "type": ["integer", "null"] },
          "start": { "type": "string", "pattern": "^[0-9]{2}:[0-5][0-9]:[0-5][0-9]$" },
          "evidence": { "type": "string" }
        },
        "required": ["title", "card", "start", "evidence"],
        "additionalProperties": false
      }
    },
    "skipped_cards": { "type": "array", "items": { "type": "integer" } },
    "outro": { "type": "string", "pattern": "^[0-9]{2}:[0-5][0-9]:[0-5][0-9]$" }
  },
  "required": ["topics", "skipped_cards", "outro"],
  "additionalProperties": false
}
